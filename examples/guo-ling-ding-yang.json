{
  "title": "过零丁洋",
  "author": "文天祥",
  "lines": [
    "辛苦遭逢起一经，干戈寥落四周星。",
    "山河破碎风飘絮，身世浮沉雨打萍。",
    "惶恐滩头说惶恐，零丁洋里叹零丁。",
    "人生自古谁无死，留取丹心照汗青。"
  ],
  "new_phrase": "生照山河，死落零丁。",
  "traditional": true,
  "font_style": "old-song",
  "palette": "ink-green",
